  <dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
      <transport_descriptors>
        <transport_descriptor>
          <transport_id>shm_big</transport_id>
          <type>SHM</type>
          <segment_size>16777216</segment_size>        <!-- 16 MiB pool per process -->
          <maxMessageSize>4194304</maxMessageSize>     <!-- 4 MiB chunks -->
        </transport_descriptor>
        <transport_descriptor>
          <transport_id>udp_default</transport_id>
          <type>UDPv4</type>
        </transport_descriptor>
      </transport_descriptors>
      <participant profile_name="big_data_participant" is_default_profile="true">
        <rtps>
          <userTransports>
            <transport_id>shm_big</transport_id>
            <transport_id>udp_default</transport_id>
          </userTransports>
          <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
      </participant>
    </rtps>
    </profiles>
  </dds>